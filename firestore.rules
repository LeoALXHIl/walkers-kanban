rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────
    // Cofre do refresh_token Google (conexão persistente).
    // NEGADO a todo cliente — só o Admin SDK (Cloud Functions) acessa.
    // Tem que vir ANTES de qualquer match amplo. Fica FORA de users/{uid}
    // de propósito: lá a regra recursiva concederia leitura ao dono.
    // ──────────────────────────────────────────────────────
    match /googleAuth/{uid} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────
    // Per-user data: profile, legacy kanban
    // Acesso restrito ao próprio dono.
    // ──────────────────────────────────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ──────────────────────────────────────────────────────
    // Workspaces: dados compartilhados entre membros
    // ──────────────────────────────────────────────────────

    // Documento principal do workspace (members[], invites[], etc.)
    match /workspaces/{wsId} {
      // Ler UM doc específico: qualquer usuário autenticado.
      // Necessário pra validar o convite na hora de entrar (o usuário
      // ainda não é membro nesse momento). O wsId é aleatório e funciona
      // como parte do "segredo" do link de convite.
      allow get: if request.auth != null;

      // Listagem / queries amplas: só membros.
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.memberUids;

      // Criar: só o próprio user pode criar com si mesmo como owner.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;

      // Atualizar:
      //  (a) membro existente pode editar; OU
      //  (b) novo usuário entrando via convite — só pode ADICIONAR a si mesmo,
      //      sem remover ninguém e sem trocar o dono.
      allow update: if request.auth != null
                    && (
                      request.auth.uid in resource.data.memberUids
                      || (
                        !(request.auth.uid in resource.data.memberUids)
                        && request.auth.uid in request.resource.data.memberUids
                        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
                        && request.resource.data.ownerUid == resource.data.ownerUid
                      )
                    );

      // Deletar: só owner
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Sub-collection com os dados kanban do workspace
    match /workspaces/{wsId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wsId)).data.memberUids;
    }

    // ──────────────────────────────────────────────────────
    // Plano de assinatura do usuário (billing MVP sem backend).
    // Lido pelo próprio usuário; gravado SÓ pelo admin (ativação manual
    // pós-pagamento no Mercado Pago, até existir webhook via Functions).
    // ──────────────────────────────────────────────────────
    match /plans/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || request.auth.uid == 'QAJ08ZLj9nPj5DMjn1j97jLEL102');
      allow write: if request.auth != null
                   && request.auth.uid == 'QAJ08ZLj9nPj5DMjn1j97jLEL102';
    }

    // ──────────────────────────────────────────────────────
    // Lista de espera do plano Pro (landing). Qualquer visitante pode
    // se inscrever (create), mas ninguém lê/edita pelo cliente — só o
    // dono via console/Admin SDK. Payload limitado pra evitar abuso.
    // ──────────────────────────────────────────────────────
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'plan', 'ts'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 120;
      allow read, update, delete: if false;
    }

    // ──────────────────────────────────────────────────────
    // Portal público do cliente (publicShares/{slug})
    // Leitura pública (cliente sem login acessa pelo slug).
    // Escrita do doc só pelo dono. Comentários: qualquer um com o slug.
    // ──────────────────────────────────────────────────────
    match /publicShares/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      // Dono edita tudo; OU o cliente anônimo pode mexer SÓ em views/aprovações.
      allow update: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['views', 'lastViewedAt', 'approvals', 'updatedAt']);
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      // Comentários do cliente (sem login) + aprovações.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if request.auth != null;
      }
    }
  }
}
