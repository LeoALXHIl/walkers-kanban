{
  "name": "walkers-kanban",
  "version": "4.26.2",
  "description": "Kanban com Firebase Auth + Firestore + MCP. Refatorado em Vite + React + TS + Zustand. Distribuído via electron-builder com tray + auto-launch + auto-update.",
  "main": "main.js",
  "author": {
    "name": "Walkers",
    "email": "contato@walkers.app"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n VITE,ELEC -c magenta,cyan \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:legal": "node scripts/build-legal.cjs",
    "build": "node scripts/build-legal.cjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "mcp": "node mcp-server.js",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@sentry/react": "^8.40.0",
    "electron-updater": "^6.3.0",
    "firebase": "^10.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.8",
    "wait-on": "^7.2.0"
  }
}
